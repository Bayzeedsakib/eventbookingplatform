<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.eventbookingplatform.ui.home.HomeFragment"
        android:label="@string/nav_home">
        <action
            android:id="@+id/action_homeFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.eventbookingplatform.ui.explore.ExploreFragment"
        android:label="@string/nav_explore">
        <action
            android:id="@+id/action_exploreFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/ticketsFragment"
        android:name="com.example.eventbookingplatform.ui.tickets.TicketsFragment"
        android:label="@string/nav_tickets" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.eventbookingplatform.ui.profile.ProfileFragment"
        android:label="@string/nav_profile" />

    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="com.example.eventbookingplatform.ui.detail.EventDetailFragment"
        android:label="@string/event_detail_title">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>
</navigation>
