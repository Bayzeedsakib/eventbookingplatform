<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.eventbookingplatform.ui.home.HomeFragment"
        android:label="@string/nav_home">
        <action
            android:id="@+id/action_homeFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.eventbookingplatform.ui.explore.ExploreFragment"
        android:label="@string/nav_explore">
        <action
            android:id="@+id/action_exploreFragment_to_eventDetailFragment"
            app:destination="@id/eventDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/ticketsFragment"
        android:name="com.example.eventbookingplatform.ui.tickets.TicketsFragment"
        android:label="@string/nav_tickets" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.eventbookingplatform.ui.profile.ProfileFragment"
        android:label="@string/nav_profile">
        <action
            android:id="@+id/action_profileFragment_to_adminEventsFragment"
            app:destination="@id/adminEventsFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminEventsFragment"
        android:name="com.example.eventbookingplatform.ui.admin.AdminEventsFragment"
        android:label="@string/admin_events_title">
        <action
            android:id="@+id/action_adminEventsFragment_to_adminEventEditFragment"
            app:destination="@id/adminEventEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminEventEditFragment"
        android:name="com.example.eventbookingplatform.ui.admin.AdminEventEditFragment"
        android:label="@string/admin_edit_event_title" />

    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="com.example.eventbookingplatform.ui.detail.EventDetailFragment"
        android:label="@string/event_detail_title">
        <argument
            android:name="eventId"
            app:argType="string" />
        <action
            android:id="@+id/action_eventDetailFragment_to_bookingFragment"
            app:destination="@id/bookingFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.eventbookingplatform.ui.booking.BookingFragment"
        android:label="@string/booking_title">
        <argument
            android:name="eventId"
            app:argType="string" />
    </fragment>
</navigation>
